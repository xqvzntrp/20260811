+ PACKAGE OrderedMinMax
    LANGUAGE_VERSION 2004.0.0
    SPEC_FILE conformance/ORDERED.SPEC.TSV
+ GROUP OrderedValues
    FROM ValueRow
    GROUP_BY ValueKey
+ PROPERTY MinimumIdentifier
    AT OrderedValues
    AS MIN(ValueRow.Id)
+ PROPERTY MaximumIdentifier
    AT OrderedValues
    AS MAX(ValueRow.Id)
+ PROPERTY MinimumString
    AT OrderedValues
    AS MIN(ValueRow.Code)
+ PROPERTY MaximumString
    AT OrderedValues
    AS MAX(ValueRow.Code)
+ PROPERTY MinimumNumber
    AT OrderedValues
    AS MIN(ValueRow.Amount)
+ PROPERTY MaximumNumber
    AT OrderedValues
    AS MAX(ValueRow.Amount)
+ PROPERTY MinimumDate
    AT OrderedValues
    AS MIN(ValueRow.RecordedDate)
+ PROPERTY MaximumDate
    AT OrderedValues
    AS MAX(ValueRow.RecordedDate)

